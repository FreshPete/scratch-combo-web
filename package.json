{
  "name": "scratch-combo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
